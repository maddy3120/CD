
#include <stdio.h>
#include <ctype.h>
#include <string.h>

char input[100];
int i = 0, error = 0;

void E();
void Eprime();
void T();
void Tprime();
void F();

void E() {
    T();
    if (!error)
        Eprime();
}

void Eprime() {
    if (input[i] == '+') {
        i++;
        T();
        if (!error)
            Eprime();
    }
}

void T() {
    F();
    if (!error)
        Tprime();
}

void Tprime() {
    if (input[i] == '*') {
        i++;
        F();
        if (!error)
            Tprime();
    }
}

void F() {
    if (isalnum((unsigned char)input[i])) {
        i++;
    }
    else if (input[i] == '(') {
        i++;
        E();

        if (input[i] == ')' && !error)
            i++;
        else {
            printf("Error: Missing ) or invalid expression\n");
            error = 1;
        }
    }
    else {
        printf("Error: Invalid Expression\n");
        error = 1;
    }
}

int main() {
    printf("Enter expression: ");
    if (scanf("%99s", input) != 1)
        return 1;

    E();

    if (input[i] == '\0' && error == 0)
        printf("String is accepted.\n");
    else
        printf("String is rejected.\n");

    return 0;
}
